# Krishi Mitra Backend Configuration
PROJECT_NAME="Krishi Mitra API"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# Database Configuration (MySQL 8.0 on default port 3306)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=krishi_mitra_db
DATABASE_URL="mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?charset=utf8mb4"

# CORS Configuration for Vite Frontend
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Speech / LLM API Keys (Optional - Fallback logic is built-in)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
